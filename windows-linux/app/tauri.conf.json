{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mouthy",
  "version": "0.1.0",
  "identifier": "dev.mouthy.Mouthy",
  "build": { "frontendDist": "frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "create": false, "title": "Mouthy", "url": "index.html", "width": 980, "height": 700, "minWidth": 820, "minHeight": 560, "visible": true, "center": true },
      { "label": "overlay", "create": false, "title": "Mouthy recording", "url": "overlay.html", "width": 160, "height": 40, "visible": false,
        "decorations": false, "transparent": true, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false, "focus": false, "focusable": false, "shadow": false }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Local dictation with Parakeet and Whisper",
    "category": "Productivity"
  }
}
