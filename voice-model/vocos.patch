diff --git a/vocos/mouthy_features.py b/vocos/mouthy_features.py
new file mode 100644
index 0000000..5d7ae5a
--- /dev/null
+++ b/vocos/mouthy_features.py
@@ -0,0 +1,21 @@
+"""Mouthy: Matcha-TTS's mel (librosa filters, reflect pad, no centring) so this vocoder reads Mouthy's acoustic model output."""
+import torch
+from librosa.filters import mel as librosa_mel_fn
+from vocos.feature_extractors import FeatureExtractor
+
+
+class MatchaMelFeatures(FeatureExtractor):
+    def __init__(self, sample_rate: int = 24000, n_fft: int = 1024, hop_length: int = 256, n_mels: int = 100, f_max: float = 12000):
+        super().__init__()
+        self.n_fft, self.hop_length = n_fft, hop_length
+        basis = librosa_mel_fn(sr=sample_rate, n_fft=n_fft, n_mels=n_mels, fmin=0, fmax=f_max)
+        self.register_buffer("mel_basis", torch.from_numpy(basis).float())
+        self.register_buffer("window", torch.hann_window(n_fft))
+
+    def forward(self, audio: torch.Tensor, **kwargs) -> torch.Tensor:
+        pad = (self.n_fft - self.hop_length) // 2
+        y = torch.nn.functional.pad(audio.unsqueeze(1), (pad, pad), mode="reflect").squeeze(1)
+        spec = torch.stft(y, self.n_fft, hop_length=self.hop_length, win_length=self.n_fft, window=self.window,
+                          center=False, return_complex=True)
+        spec = torch.sqrt(spec.real.pow(2) + spec.imag.pow(2) + 1e-9)
+        return torch.log(torch.clamp(self.mel_basis @ spec, min=1e-5))
